  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fc98bb6960d521d4084dda2b63f33307, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OpeningDialogManager
  phoneAudioSource: {fileID: 1568038494}
  phoneVibrateClip: {fileID: 8300000, guid: 6ac66a23551a3f644a3c28681557ee6f, type: 3}
  dialogRootGroup: {fileID: 743999921}
  wicakImage: {fileID: 1425319287}
  aksaImage: {fileID: 1339164397}
  dialogueText: {fileID: 247535025}
  dialogEntries:
  - speaker: Wicak
    wicakExpression: {fileID: 21300000, guid: 43eb35a3d8b683d498c7091e573037cc, type: 3}
    aksaExpression: {fileID: 21300000, guid: 6cb2d331d888b234cbc186bb1691d6d1, type: 3}
    text: 'Wicak: "......"'
  - speaker: Aksa
    wicakExpression: {fileID: 21300000, guid: 9fbf6e48724af9849a4c21f78bd2a101, type: 3}
    aksaExpression: {fileID: 21300000, guid: b54fb18d195cd4549a5af733a6480845, type: 3}
    text: 'Aksa: "Cak?"'
  - speaker: Wicak
    wicakExpression: {fileID: 21300000, guid: 43eb35a3d8b683d498c7091e573037cc, type: 3}
    aksaExpression: {fileID: 21300000, guid: 6cb2d331d888b234cbc186bb1691d6d1, type: 3}
    text: 'Wicak: "Maaf ya sa, terakhir kita ketemu malah berantem"'
  - speaker: Aksa
    wicakExpression: {fileID: 21300000, guid: ceeb7dfc780611f4293dae5df54c4930, type: 3}
    aksaExpression: {fileID: 21300000, guid: 2a36e6aa95ce9b942acba1fb3482800d, type: 3}
    text: 'Aksa: "Udah lama juga lagian jangan dipikirin"'
  - speaker: Wicak
    wicakExpression: {fileID: 21300000, guid: 43eb35a3d8b683d498c7091e573037cc, type: 3}
    aksaExpression: {fileID: 21300000, guid: 6cb2d331d888b234cbc186bb1691d6d1, type: 3}
    text: 'Wicak: "Coba dulu aku dengerin kamu ya sa, gabakal kaya gini sekarang"'
  - speaker: Aksa
    wicakExpression: {fileID: 21300000, guid: 43eb35a3d8b683d498c7091e573037cc, type: 3}
    aksaExpression: {fileID: 21300000, guid: 2062b7f8acf592c47aa9ee1b3297b13b, type: 3}
    text: 'Aksa: "Maksudnya?"'
  - speaker: Wicak
    wicakExpression: {fileID: 21300000, guid: ceeb7dfc780611f4293dae5df54c4930, type: 3}
    aksaExpression: {fileID: 21300000, guid: 6cb2d331d888b234cbc186bb1691d6d1, type: 3}
    text: 'Wicak: "Gapapa, inget ga sih dulu kita milih SMA ini karena ini satu-satunya
      jalan keluar kita? Naif ya"'
  - speaker: Aksa
    wicakExpression: {fileID: 21300000, guid: ceeb7dfc780611f4293dae5df54c4930, type: 3}
    aksaExpression: {fileID: 21300000, guid: a4f11e4bcc357b44698c85b34b5e7026, type: 3}
    text: 'Aksa: "Ngga, aku masih percaya hal itu. Kamu juga kan?"'
  - speaker: Wicak
    wicakExpression: {fileID: 21300000, guid: 387024ccda8de3542948c73d67d4681f, type: 3}
    aksaExpression: {fileID: 21300000, guid: 2062b7f8acf592c47aa9ee1b3297b13b, type: 3}
    text: 'Wicak: "Ngga, udah ngga. Aku salah jalan"'
  - speaker: Aksa
    wicakExpression: {fileID: 21300000, guid: 387024ccda8de3542948c73d67d4681f, type: 3}
    aksaExpression: {fileID: 21300000, guid: 2062b7f8acf592c47aa9ee1b3297b13b, type: 3}
    text: 'Aksa: "Hah"'
  - speaker: Wicak
    wicakExpression: {fileID: 21300000, guid: ceeb7dfc780611f4293dae5df54c4930, type: 3}
    aksaExpression: {fileID: 21300000, guid: 2062b7f8acf592c47aa9ee1b3297b13b, type: 3}
    text: 'Wicak: "Udahan ah, thank you ya buat semuanya Sa."'
  - speaker: Aksa
    wicakExpression: {fileID: 21300000, guid: 387024ccda8de3542948c73d67d4681f, type: 3}
    aksaExpression: {fileID: 21300000, guid: 9b1be3d3cc019e040a6e0031bb74abe9, type: 3}
