--- !u!114 &1156196356
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1156196355}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fc98bb6960d521d4084dda2b63f33307, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OpeningDialogManager
  phoneAudioSource: {fileID: 0}
  phoneVibrateClip: {fileID: 0}
  dialogRootGroup: {fileID: 2073318547}
  wicakImage: {fileID: 2012166073}
  aksaImage: {fileID: 1342296486}
  dialogueText: {fileID: 593532216}
  dialogEntries:
  - speaker: aksa
    wicakExpression: {fileID: 21300000, guid: f7d561811030e3a4581c467e652248b8, type: 3}
    aksaExpression: {fileID: 21300000, guid: a4d716d4f378db248891887ef2dee780, type: 3}
    text: 'Aksa: "Kamu ga ngelayat? Wicak meninggal."'
  - speaker: wicak
    wicakExpression: {fileID: 21300000, guid: d05b32781330f5d4db487886b258bd47, type: 3}
    aksaExpression: {fileID: 21300000, guid: 9fcce6129023eae4b8a9a2fedafddb65, type: 3}
    text: 'Aldi: "Aku ada urusan. Lagian anak-anak yang lain udah pada ke sana, kan?"'
  - speaker: aksa
    wicakExpression: {fileID: 21300000, guid: f7d561811030e3a4581c467e652248b8, type: 3}
    aksaExpression: {fileID: 21300000, guid: a4d716d4f378db248891887ef2dee780, type: 3}
    text: 'Aksa: "Urusan apa? Kamu temennya. Kamu tau soal dia overdosis?"'
  - speaker: wicak
    wicakExpression: {fileID: 21300000, guid: d05b32781330f5d4db487886b258bd47, type: 3}
    aksaExpression: {fileID: 21300000, guid: 9fcce6129023eae4b8a9a2fedafddb65, type: 3}
    text: 'Aldi: "Yaelah. tuh orang overdosis bukan tanggung jawabku. Wicak yang
      milih jalannya sendiri buat join kita lagian."'
  - speaker: aksa
    wicakExpression: {fileID: 21300000, guid: f7d561811030e3a4581c467e652248b8, type: 3}
    aksaExpression: {fileID: 21300000, guid: a4d716d4f378db248891887ef2dee780, type: 3}
    text: 'Aksa: "Tuh orang? Kamu temennya dia benera ga sih? Jangan-jangan kamu
      malah manfaatin dia, kan? Kamu pikir aku ga liat chat kamu cuma jadii dia kacung?!"'
  - speaker: wicak
    wicakExpression: {fileID: 21300000, guid: d05b32781330f5d4db487886b258bd47, type: 3}
    aksaExpression: {fileID: 21300000, guid: 9fcce6129023eae4b8a9a2fedafddb65, type: 3}
    text: 'Aldi: "Kacung? Dia dapet nama main sama kita, juga dapet duit kan. Kalau
      dia bodoh sampe kebablasan sendiri, itu urusannya. Lagian kamu ke mana aja?
      Sahabat macam apa yang baru nyariin pas orangnya udah mati?"'
  - speaker: aksa
    wicakExpression: {fileID: 21300000, guid: f7d561811030e3a4581c467e652248b8, type: 3}
    aksaExpression: {fileID: 21300000, guid: a4d716d4f378db248891887ef2dee780, type: 3}
    text: 'Aksa: "Anj*ng. Kamu tahu sesuatu kan soal semalem?"'
  - speaker: wicak
    wicakExpression: {fileID: 21300000, guid: d05b32781330f5d4db487886b258bd47, type: 3}
    aksaExpression: {fileID: 21300000, guid: 9fcce6129023eae4b8a9a2fedafddb65, type: 3}
    text: "Aldi: \"Aku ga tahu apa-apa. Lagian dia biasanya cuma aku suruh ambil
      barang ke gudang kembang api\u2014\""
  - speaker: wicak
    wicakExpression: {fileID: 21300000, guid: d05b32781330f5d4db487886b258bd47, type: 3}
    aksaExpression: {fileID: 21300000, guid: 9fcce6129023eae4b8a9a2fedafddb65, type: 3}
    text: 'Aldi: "...sial."'
  - speaker: aksa
    wicakExpression: {fileID: 21300000, guid: f7d561811030e3a4581c467e652248b8, type: 3}
    aksaExpression: {fileID: 21300000, guid: a4d716d4f378db248891887ef2dee780, type: 3}
    text: 'Aksa: "Gudang kembang api? Kamu nyuruh-nyuruh dia? NGAPAIN?!"'
  - speaker: wicak
    wicakExpression: {fileID: 21300000, guid: d05b32781330f5d4db487886b258bd47, type: 3}
    aksaExpression: {fileID: 21300000, guid: 9fcce6129023eae4b8a9a2fedafddb65, type: 3}
    text: 'Aldi: "Woi, lupain apa yang aku bilang tadi. Jangan coba-coba ke ruang
      OSIS buat nyari map denah gudang itu di meja tengah."'
  - speaker: wicak
    wicakExpression: {fileID: 21300000, guid: d05b32781330f5d4db487886b258bd47, type: 3}
    aksaExpression: {fileID: 21300000, guid: 9fcce6129023eae4b8a9a2fedafddb65, type: 3}
    text: 'Aldi: "Kalau kamu berani ke ruang OSIS, kita ga akan segan buat ngejar
      dan habisin kamu."'
  onDialogFinished:
    m_PersistentCalls:
      m_Calls: []
  overlayFadeDuration: 0.5
  speakerScale: 1.15
  listenerScale: 1.12
  listenerDimValue: 0.4
  mainCamera: {fileID: 0}
  blackOverlay: {fileID: 186491814}
  cameraFadeDuration: 0.5
  hallwayCameraPosition: {x: 0, y: 1, z: -10}
  kelasCameraPosition: {x: 18.41, y: 0.97, z: -10}
